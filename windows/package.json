{
  "name": "soulfork-tv",
  "productName": "SoulFork TV",
  "version": "1.0.0",
  "description": "SoulFork TV — player de IPTV (M3U e Xtream) para Windows",
  "main": "main.js",
  "author": "SoulFork",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "web": "node copy-web.js",
    "start": "npm run web && electron .",
    "dist": "npm run web && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "hls.js": "1.5.17"
  },
  "build": {
    "appId": "br.com.soulfork.tv",
    "productName": "SoulFork TV",
    "artifactName": "SoulForkTV-Setup.${ext}",
    "files": ["main.js", "preload.js", "web/**"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "web/icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SoulFork TV"
    }
  }
}
