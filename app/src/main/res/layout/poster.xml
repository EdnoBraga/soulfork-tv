<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="132dp"
    android:layout_margin="4dp" android:padding="3dp" android:background="@drawable/tile"
    android:focusable="true" android:clickable="true">

    <ImageView android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" />
    <TextView android:id="@+id/caption" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="#B3000000" android:padding="4dp"
        android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
</FrameLayout>
