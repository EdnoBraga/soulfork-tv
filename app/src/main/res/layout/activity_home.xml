<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="48dp">

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="90dp" android:layout_height="90dp" android:src="@drawable/logo" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:text="SoulFork TV"
            android:textSize="40sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="200dp"
        android:layout_marginTop="40dp" android:orientation="horizontal">
        <Button android:id="@+id/live" style="@style/Tile" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginEnd="12dp" android:textSize="26sp" />
        <Button android:id="@+id/movies" style="@style/Tile" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:textSize="26sp" />
        <Button android:id="@+id/series" style="@style/Tile" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="12dp" android:textSize="26sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="28dp" android:orientation="horizontal">
        <Button android:id="@+id/reload" style="@style/Tile" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginEnd="12dp"
            android:textSize="16sp" android:text="Atualizar lista" />
        <Button android:id="@+id/logout" style="@style/Tile" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp" android:text="Trocar lista" />
    </LinearLayout>
</LinearLayout>
